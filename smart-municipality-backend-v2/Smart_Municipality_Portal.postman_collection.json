{
  "info": {
    "name": "Smart Municipality Portal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "citizen_token", "value": "" },
    { "key": "business_token", "value": "" },
    { "key": "officer_token", "value": "" },
    { "key": "admin_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Test Citizen\",\n  \"email\": \"citizen2@test.com\",\n  \"password\": \"test1234\",\n  \"role\": \"Citizen\"\n}"
            }
          }
        },
        {
          "name": "Login (any role)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen2@test.com\",\n  \"password\": \"test1234\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizen_token}}" }],
            "url": "{{base_url}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": { "method": "GET", "url": "{{base_url}}/categories" }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Browse Products",
          "request": { "method": "GET", "url": "{{base_url}}/products" }
        },
        {
          "name": "Get Single Product",
          "request": { "method": "GET", "url": "{{base_url}}/products/1" }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "View Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizen_token}}" }],
            "url": "{{base_url}}/cart"
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizen_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/cart/items",
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}" }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizen_token}}" }],
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizen_token}}" }],
            "url": "{{base_url}}/orders/my-orders"
          }
        }
      ]
    },
    {
      "name": "Certificates",
      "item": [
        {
          "name": "Apply for Certificate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizen_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/certificates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"certificate_type\": \"Residence\",\n  \"purpose\": \"Bank account opening\"\n}"
            }
          }
        },
        {
          "name": "My Certificate Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizen_token}}" }],
            "url": "{{base_url}}/certificates/my-requests"
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "Submit Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizen_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/complaints",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Streetlight not working\",\n  \"description\": \"The streetlight on Main St has been off for a week.\",\n  \"location\": \"Ward 3\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Notices",
      "item": [
        {
          "name": "Get All Notices",
          "request": { "method": "GET", "url": "{{base_url}}/notices" }
        }
      ]
    },
    {
      "name": "Tax",
      "item": [
        {
          "name": "Pay Tax (demo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizen_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/tax/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tax_type\": \"House Tax\",\n  \"amount\": 5000,\n  \"payment_method\": \"eSewa\"\n}"
            }
          }
        },
        {
          "name": "My Tax Records",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizen_token}}" }],
            "url": "{{base_url}}/tax/my-taxes"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/admin/analytics"
          }
        }
      ]
    }
  ]
}
