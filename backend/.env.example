PORT=5000

# MySQL connection. For local dev this is XAMPP's defaults; for a real
# deployment, point these at your cloud MySQL host instead.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_municipality_portal

# Generate your own random value, e.g.: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# One-time secret for POST /api/auth/admin/bootstrap — the only way to create
# the system's single Admin account (see authController.js). Generate your
# own random value, e.g.: openssl rand -hex 32
ADMIN_BOOTSTRAP_KEY=

# Comma-separated list of origins allowed to call this API in production,
# e.g. https://smartmunicipality.netlify.app
ALLOWED_ORIGINS=
